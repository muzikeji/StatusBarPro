<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- 顶部状态栏组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>顶部显示</string>
            <key>footerText</key>
            <string>兼容 iOS 15 - 17，部分选项需要 Respring 后生效</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>24 小时制</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>use24h</string>
            <key>default</key>
            <true/>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>显示秒钟</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>showSeconds</string>
            <key>default</key>
            <false/>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>显示日期</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>showDate</string>
            <key>default</key>
            <true/>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>显示星期</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>showWeekday</string>
            <key>default</key>
            <true/>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>显示农历</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>showLunar</string>
            <key>default</key>
            <true/>
        </dict>

        <!-- 信号图标组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>信号图标</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSegmentCell</string>
            <key>label</key>
            <string>风格</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>signalStyle</string>
            <key>default</key>
            <string>2</string>
            <key>validTitles</key>
            <array>
                <string>经典</string>
                <string>方形</string>
                <string>圆角</string>
            </array>
            <key>validValues</key>
            <array>
                <string>0</string>
                <string>1</string>
                <string>2</string>
            </array>
        </dict>

        <!-- WiFi 组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>WiFi 图标</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>启用自定义</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>wifiCustom</string>
            <key>default</key>
            <true/>
        </dict>

        <!-- 电池组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>电池图标</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSegmentCell</string>
            <key>label</key>
            <string>风格</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>batteryStyle</string>
            <key>default</key>
            <string>0</string>
            <key>validTitles</key>
            <array>
                <string>经典</string>
                <string>胶囊</string>
                <string>百分号</string>
            </array>
            <key>validValues</key>
            <array>
                <string>0</string>
                <string>1</string>
                <string>2</string>
            </array>
        </dict>

        <!-- 颜色组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>外观</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSLinkCell</string>
            <key>label</key>
            <string>前景色</string>
            <key>action</key>
            <string>openColorPicker</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>跟随系统暗黑模式</string>
            <key>defaults</key>
            <string>com.muzikeji.statusbarpro</string>
            <key>key</key>
            <string>autoDarkMode</string>
            <key>default</key>
            <true/>
        </dict>
    </array>
</dict>
</plist>